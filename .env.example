APP_NAME="Payroll - Majma al Markazi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=payroll
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="payroll@majmaalmarkazi.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- AIIMS Central ERP integration (employee master data) ---
# driver: mock (default, demo data) | http (real integration once AIIMS exposes its API)
AIIMS_DRIVER=mock
AIIMS_BASE_URL=
AIIMS_API_KEY=
AIIMS_TIMEOUT=30

# --- Financial ERP integration (journal voucher posting) ---
# driver: mock (default, simulated posting) | http (real integration once Financial ERP endpoint is confirmed)
FINANCIAL_ERP_DRIVER=mock
FINANCIAL_ERP_BASE_URL=
FINANCIAL_ERP_API_KEY=
FINANCIAL_ERP_TIMEOUT=30

# Static API keys accepted on the inbound integration endpoints (routes/api.php)
PAYROLL_INBOUND_API_KEY=change-me-local-dev-key
